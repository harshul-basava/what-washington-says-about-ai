  {
   "sid": "s6",
   "date": null,
   "url": "https://www.ai.mil/Initiatives/Open-DAGIR/",
   "text": "Open Data and Applications Government-owned Interoperable Repositories (DAGIR) is CDAO's new approach to scaling data analytics and AI capabilities.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Chief Digital and Artificial Intelligence Office",
    "organization_id": "cdao",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
