  {
   "sid": "s2",
   "date": null,
   "url": "https://www.ai.mil/Initiatives/Open-DAGIR/",
   "text": "Open DAGIR is, by construction, not about a single company or product. It is a way to leverage a competitive acquisition process to rapidly procure and integrate best-in-class technology from industry to meet specific DoW requirements and ensure interoperability.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Chief Digital and Artificial Intelligence Office",
    "organization_id": "cdao",
    "basis": "local_span",
