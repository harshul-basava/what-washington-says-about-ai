  "summary": {
   "status": "complete",
   "text": "In a September 1, 2026, official-role post, Brooke L. Rollins said AI can help producers identify pests, determine which crops need water, conserve resources, and operate more efficiently. In a September 17, 2025, official-role post, she said AI is transforming agriculture and that America is leading the charge. In an undated personal statement, she said government should do certain things while also protecting farmers’ privacy and security. In a November 10, 2026, official-role post, she described using AI to flag possible inconsistencies in reports before publication, citing better information, less paperwork, and greater trust.",
   "sids": [
    "s1",
    "s2",
    "s3",
    "s4"
   ],
   "sentences": [
    {
     "text": "In a September 1, 2026, official-role post, Brooke L. Rollins said AI can help producers identify pests, determine which crops need water, conserve resources, and operate more efficiently.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "In a September 17, 2025, official-role post, she said AI is transforming agriculture and that America is leading the charge.",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "In an undated personal statement, she said government should do certain things while also protecting farmers’ privacy and security.",
     "sids": [
      "s3"
     ]
    },
    {
     "text": "In a November 10, 2026, official-role post, she described using AI to flag possible inconsistencies in reports before publication, citing better information, less paperwork, and greater trust.",
     "sids": [
      "s4"
     ]
    }
   ]
