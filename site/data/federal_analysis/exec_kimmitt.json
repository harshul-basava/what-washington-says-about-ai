  {
   "sid": "s9",
   "date": null,
   "url": "https://www.trade.gov/press-release/department-commerce-announces-new-american-ai-exports-program-phase",
   "text": "America’s continued global leadership in AI depends on our ability to export our AI to allies around the world,” said Under Secretary of Commerce for International Trade William Kimmitt. “We will continue to focus our resources to most effectively implement the President’s export directives and position America’s AI innovators and workers to win globally.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "William Kimmitt",
    "organization_id": "commerce",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
