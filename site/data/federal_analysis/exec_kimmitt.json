   "sid": "s6",
   "date": "2026-03-16",
   "url": "https://youcongress.org/c/15746",
   "text": "America’s continued global leadership in AI depends on our ability to export our AI to allies around the world.",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "William Kimmitt",
    "organization_id": "commerce",
    "basis": "local_span",
