  },
  {
   "sid": "s7",
   "date": null,
   "url": "https://www.trade.gov/feature-article/remarks-under-secretary-william-kimmitt-hudson-institute",
   "text": "We’re also working to make American technology the foundation for growth around the world. At Commerce, we are proudly implementing President Trump’s American AI Exports Program, building on his initiative to promote the American AI technology stack.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "William Kimmitt",
    "organization_id": "commerce",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
