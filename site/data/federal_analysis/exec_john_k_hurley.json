  "summary": {
   "status": "complete",
   "text": "John K. Hurley said financial institutions that experiment with AI and reduce false positives while escalating vital information to law enforcement more quickly should be celebrated rather than written up. Hurley also said he would support broader innovation, including AI, blockchain analysis, digital identity, and APIs, as part of a smarter AML framework.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
    {
     "text": "John K. Hurley said financial institutions that experiment with AI and reduce false positives while escalating vital information to law enforcement more quickly should be celebrated rather than written up.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "Hurley also said he would support broader innovation, including AI, blockchain analysis, digital identity, and APIs, as part of a smarter AML framework.",
     "sids": [
      "s2"
     ]
    }
   ]
