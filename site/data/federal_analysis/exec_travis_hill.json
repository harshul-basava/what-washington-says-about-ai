  {
   "sid": "s4",
   "date": "2026-06-04",
   "url": "https://www.fdic.gov/news/speeches/2026/oversight-prudential-regulators",
   "text": "Additionally, the proposal encourages responsible innovation and the use of emerging technologies, such as artificial intelligence, to detect and disrupt illicit finance activity more effectively.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Travis Hill",
    "organization_id": "fdic",
