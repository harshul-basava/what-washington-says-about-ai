 "statements": [
  {
   "sid": "s1",
   "date": "2025-10-23",
   "url": "https://www.gsa.gov/about-gsa/newsroom/congressional-testimony/nomination-of-edward-c-forst-to-be-administrator-us-general-services-administration-10232025",
   "text": "GSA must continue to lead the way in technology transformation across the government. Under President Trump’s leadership, the Administration has prioritized the responsible and accelerated adoption of artificial intelligence (AI) and automation to improve service delivery and efficiency.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Edward Forst",
