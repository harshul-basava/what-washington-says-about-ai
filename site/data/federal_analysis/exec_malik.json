   "sid": "s1",
   "date": "2026-03-23",
   "url": "https://home.treasury.gov/news/press-releases/sb0421",
   "text": "AI is moving from experimentation to enterprise-wide integration, and disciplined implementation will determine its impact,” said Paras Malik, Treasury’s Chief AI Officer and Counselor to the Secretary. “The priority now is on operationalization, embedding AI into core workflows in ways that measurably enhance risk management and resilience.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Paras Malik",
    "organization_id": "treasury",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Chief AI Officer and Counselor to the Secretary"
   },
