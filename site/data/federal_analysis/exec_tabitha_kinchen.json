  "summary": {
   "status": "complete",
   "text": "Tabitha Kinchen stated in August 2025 that a “one-size-fits-all” approach does not work for buying AI-based software and aircraft carriers. In March 2026, she said that as systems increasingly rely on autonomous systems, sensors, and edge compute, power is becoming a limiting factor for operational capability.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
    {
     "text": "Tabitha Kinchen stated in August 2025 that a “one-size-fits-all” approach does not work for buying AI-based software and aircraft carriers.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "In March 2026, she said that as systems increasingly rely on autonomous systems, sensors, and edge compute, power is becoming a limiting factor for operational capability.",
     "sids": [
      "s2"
     ]
    }
   ]
