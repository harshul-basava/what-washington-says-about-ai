   }
  },
  {
   "sid": "s10",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/statement-holyoak-ai-6b-study_0.pdf",
   "text": "Accordingly, President Trump declared in January 2025 that it is United States policy to sustain and enhance the United States’ global AI dominance and ordered development of an AI action plan.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s11",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/statement-holyoak-ai-6b-study_0.pdf",
   "text": "The resulting America’s AI Action Plan issued in July 2025 calls for the United States to innovate faster and more comprehensively than our competitors in the development and distribution of new AI technology and to dismantle unnecessary regulatory barriers.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s12",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/statement-holyoak-ai-6b-study_0.pdf",
   "text": "Consistent with that plan, we at the Federal Trade Commission are committed to giving AI the ability to develop and reach its potential.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s13",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/statement-holyoak-ai-6b-study_0.pdf",
   "text": "At the same time, when it comes to AI, the Commission will work to meet our mandate to ensure competitive markets and protect consumers from fraudulent and other unlawful conduct.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
