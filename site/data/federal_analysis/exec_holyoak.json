   }
  },
  {
   "sid": "s9",
   "date": "2025-01-30",
   "url": "https://www.ftc.gov/system/files/ftc_gov/pdf/2025-02-04-holyoak-remarksr-for-global-competition-review-event.pdf",
   "text": "Part of the Commission’s investigations could also include investigating ways that trust and safety professionals may be collaboratively seeking to affect how AI is developed to moderate content.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
