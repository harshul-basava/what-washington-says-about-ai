   }
  },
  {
   "sid": "s8",
   "date": "2025-01-30",
   "url": "https://www.ftc.gov/system/files/ftc_gov/pdf/2025-02-04-holyoak-remarksr-for-global-competition-review-event.pdf",
   "text": "This led to innovative solutions—including using AI technologies itself—to address the emerging threats that voice cloning poses to consumers and honest business.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Melissa Holyoak",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
