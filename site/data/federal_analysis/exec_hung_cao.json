  {
   "sid": "s2",
   "date": "2026-07-14",
   "url": "https://www.navy.mil/Press-Office/Press-Releases/display-pressreleases/Article/4545237/acting-secretary-of-the-navy-signs-strategy-to-weaponize-data-and-artificial-in/",
   "text": "This strategy positions the Department of the Navy to out-learn and out-fight any adversary by rapidly deploying data and artificial intelligence,” said Acting Secretary of the Navy Hung Cao. “It is our roadmap to building an ‘AI-first’ Fleet, one that turns information into warfighting advantage and enables faster, better decisions.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Hung Cao",
    "organization_id": "war",
    "basis": "local_span",
