  {
   "sid": "s3",
   "date": "2026-04-28",
   "url": "https://defensescoop.com/2026/04/28/hung-cao-navy-secretary-modern-day-marine-speech/",
   "text": "We need AI to get faster, better, smarter — whether it’s in ship repair, or ship maintenance, or just help us make that decision.",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Hung Cao",
    "organization_id": "war",
