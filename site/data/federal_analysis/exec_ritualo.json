  "summary": {
   "status": "complete",
   "text": "As Acting Chief Data and Artificial Intelligence Officer, Amy Ritualo directs the State Department’s enterprise data and AI strategy, governance, and implementation, according to an official biography. She has said that AI is not a technology problem but a people and confidence problem. She has also emphasized that employees own the actions and outcomes taken and encouraged using AI to improve workflow processes. She has noted that people may prefer to hear from an economy officer in Nigeria using AI rather than from her team.",
   "sids": [
    "s5",
    "s2",
    "s1",
    "s4",
    "s3"
   ],
