  "summary": {
   "status": "complete",
   "text": "Alicia Jackson described agentic AI as a \"massive opportunity for democratizing healthcare access\" and said the ADVOCATE program would let patients ask about heart health and receive reliable support and clinical interventions, aiming to pave the way for FDA-authorized agentic tools (s1, s4). She said a program harnessing AI, advanced diagnostics, and real-time immune monitoring would give ICU clinicians tools to see what is happening inside the body during critical illness (s2). She described AI as a \"time machine\" to apply results and impact women today (s3). She also said ARPA-H CATALYST awards back teams building human-based, AI-enabled models to forecast drug safety and efficacy before clinical trials (s5), and that the IGoR program will modernize how evidence is generated, shared, and validated (s7).",
   "sids": [
    "s1",
    "s4",
    "s2",
    "s3",
    "s5",
    "s7"
   ],
   "sentences": [
    {
     "text": "Alicia Jackson described agentic AI as a \"massive opportunity for democratizing healthcare access\" and said the ADVOCATE program would let patients ask about heart health and receive reliable support and clinical interventions, aiming to pave the way for FDA-authorized agentic tools (s1, s4).",
     "sids": [
      "s1",
      "s4"
     ]
    },
    {
     "text": "She said a program harnessing AI, advanced diagnostics, and real-time immune monitoring would give ICU clinicians tools to see what is happening inside the body during critical illness (s2).",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "She described AI as a \"time machine\" to apply results and impact women today (s3).",
     "sids": [
      "s3"
     ]
    },
    {
     "text": "She also said ARPA-H CATALYST awards back teams building human-based, AI-enabled models to forecast drug safety and efficacy before clinical trials (s5), and that the IGoR program will modernize how evidence is generated, shared, and validated (s7).",
     "sids": [
      "s5",
      "s7"
     ]
    }
   ]
