  "summary": {
   "status": "complete",
   "text": "In a personal essay originally published August 23, 2014, Christiano anticipated substantial welfare benefits from AI-driven growth and automation, while assigning greater long-run humanitarian importance to the risk that human values would lose influence over the future. In the statement dated September 9, 2026, he said he expected permanent loss of control if superintelligence were built without more robust alignment.",
   "sids": [
    "s5",
    "s1"
   ],
   "sentences": [
    {
     "text": "In a personal essay originally published August 23, 2014, Christiano anticipated substantial welfare benefits from AI-driven growth and automation, while assigning greater long-run humanitarian importance to the risk that human values would lose influence over the future.",
