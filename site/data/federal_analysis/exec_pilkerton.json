  {
   "sid": "s4",
   "date": "2026-10-07",
   "url": "https://home.treasury.gov/news/press-releases/sb0652",
   "text": "The Outbound Investment Security Program is an important tool aimed at addressing the advancement of key technologies by countries of concern that could pose risks to U.S. national security",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Christopher Pilkerton",
    "organization_id": "treasury",
    "basis": "local_span",
