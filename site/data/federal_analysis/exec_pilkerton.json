   }
  },
  {
   "sid": "s2",
   "date": "2025-09-04",
   "url": "https://www.banking.senate.gov/imo/media/doc/pilkerton_testimony_9-4-25.pdf",
   "text": "vigilance around just how foreign investment is introduced into this country is critical, as our adversaries will continue to be relentless in efforts to undermine our country’s assets, technological competencies, and private data.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Christopher Pilkerton",
    "organization_id": "treasury",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
