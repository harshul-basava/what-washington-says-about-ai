 "statements": [
  {
   "sid": "s1",
   "date": "2026-10-22",
   "url": "https://home.treasury.gov/news/press-releases/sb0667/",
   "text": "The proposed regulations are designed to address risks that can arise when foreign adversaries try to benefit from U.S. investment in key technology sectors,” said Assistant Secretary of the Treasury for Investment Security Christopher Pilkerton. Pilkerton added, “It will enhance the Outbound Investment Security Program and our efforts to protect U.S. national security.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Christopher Pilkerton",
    "organization_id": "treasury",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
