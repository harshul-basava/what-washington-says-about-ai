  {
   "sid": "s2",
   "date": "2026-08-23",
   "url": "https://x.com/EDSecMcMahon/status/2091585516885918134",
   "text": "AI used responsibly in the classroom can revolutionize how students learn. I’ve seen it firsthand at the Alpha School in Austin, Texas. https://t.co/8oLjp7n05P",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Linda E. McMahon",
    "basis": "verified_x_account",
    "account": "EDSecMcMahon",
    "user_id": "1882496976115404800",
