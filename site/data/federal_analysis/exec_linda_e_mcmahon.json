   "url": "https://x.com/EDSecMcMahon/status/2102775232436084787",
   "text": "The new @EducationFL Artificial Intelligence rules are a great example of states paving the way for responsible AI use in the classroom. Florida’s new rules",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Linda E. McMahon",
    "basis": "verified_x_account",
    "account": "EDSecMcMahon",
    "user_id": "1882496976115404800",
