  },
  {
   "sid": "s3",
   "date": "2026-07-24",
   "url": "https://x.com/EDSecMcMahon/status/2080710880992321939",
   "text": "The next AI breakthrough shouldn’t come from Beijing. It should come from Boise, or Birmingham, or Brooklyn. https://t.co/TeCigM0ang",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Linda E. McMahon",
    "basis": "verified_x_account",
