  "summary": {
   "status": "complete",
   "text": "Wayne D. Palmer stated that MSHA pioneered an artificial intelligence platform capable of predicting real-world mine safety risks based on decades of inspection and investigation data. He said the platform is being further refined and that its predictive data will be integrated into inspector-worn smart helmets to be piloted across six mines. He also said that, when implemented, these technologies will guide MSHA field staff to focus on likely risks and hazards during inspections and help mine operators identify and mitigate risks between inspections.",
   "sids": [
    "s1",
    "s3",
    "s2"
   ],
   "sentences": [
    {
     "text": "Wayne D. Palmer stated that MSHA pioneered an artificial intelligence platform capable of predicting real-world mine safety risks based on decades of inspection and investigation data.",
