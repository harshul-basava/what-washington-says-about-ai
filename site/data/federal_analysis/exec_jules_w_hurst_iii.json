   }
  },
  {
   "sid": "s3",
   "date": "2021-03-19",
   "url": "https://mwi.westpoint.edu/tools-are-not-strategies-a-short-guide-on-artificial-intelligence-for-defense-professionals/",
   "text": "AI/ML technologies offer defense leaders incredible tools to attack longstanding problems, but they are not solutions in and of themselves.",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Jules W. Hurst III",
