   "url": "https://www.nsa.gov/Press-Room/Press-Releases-Statements/Press-Release-View/Article/3741371/nsa-publishes-guidance-for-strengthening-ai-system-security/",
   "text": "This is the first guidance led by the Artificial Intelligence Security Center (AISC) and postures the center to support one of its central goals: improving the confidentiality, integrity, and availability of AI systems.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Super Intelligence Security Center (SISC)",
    "organization_id": "sisc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
