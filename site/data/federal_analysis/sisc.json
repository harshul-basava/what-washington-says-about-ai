   "date": "2025-05-22",
   "url": "https://www.nsa.gov/Press-Room/News-Highlights/Tag/116894/ai/",
   "text": "The National Security Agency’s Artificial Intelligence Security Center (AISC) is releasing the joint Cybersecurity Information Sheet (CSI), “AI Data Security: Best Practices for Securing Data Used to Train & Operate AI Systems,” to provide best practices and recommendations for the data security of AI systems.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Super Intelligence Security Center (SISC)",
    "organization_id": "sisc",
    "note": "Automated extraction; exact quote and local attribution span matched the retrieved source."
