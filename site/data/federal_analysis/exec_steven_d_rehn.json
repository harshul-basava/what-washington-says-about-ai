  "summary": {
   "status": "complete",
   "text": "In an August 2023 reported statement, Steven D. Rehn said AI and machine learning were shifting the paradigm to give an advantage back to the defender. In another August 2023 reported statement, he said technology had been picked up and pushed into edge computing devices, which he called the lower echelon tactical analytic platform.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
    {
     "text": "In an August 2023 reported statement, Steven D. Rehn said AI and machine learning were shifting the paradigm to give an advantage back to the defender.",
