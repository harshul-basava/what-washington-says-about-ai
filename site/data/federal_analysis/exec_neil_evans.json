  "summary": {
   "status": "complete",
   "text": "Neil Evans said he gets excited about new technologies that are coming. He said what can be accomplished using health information technologies will continue to improve as new capabilities, including artificial intelligence, are introduced. He said that over the next three years he wants equitable access to experiences—including for electronic health records, telehealth systems, or new artificial intelligence systems—not to be lost sight of.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "Neil Evans said he gets excited about new technologies that are coming.",
     "sids": [
