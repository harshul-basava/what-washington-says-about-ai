  "summary": {
   "status": "complete",
   "text": "Kevin E. Lunday said in August 2024 that the Coast Guard was already using AI in small, important ways that were making a difference. In May 2025, he stated that the Coast Guard was using AI technology with U.S. Cyber Command and CISA within the Department of Homeland Security in the cyber operations space.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
    {
     "text": "Kevin E. Lunday said in August 2024 that the Coast Guard was already using AI in small, important ways that were making a difference.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "In May 2025, he stated that the Coast Guard was using AI technology with U.S. Cyber Command and CISA within the Department of Homeland Security in the cyber operations space.",
     "sids": [
