  "summary": {
   "status": "complete",
   "text": "On October 24, 2024, the National Security Council promoted an AI National Security Memorandum and linked coverage stating that the memo asks the military to increase its use of AI. The same day, it highlighted the release of AI guidelines for national security and intelligence agencies. It also referenced the Sustainable Development Goals through AI initiatives and credited U.S. re-engagement with UNESCO.",
   "sids": [
    "s5",
    "s4",
    "s3",
    "s2"
   ],
   "sentences": [
    {
     "text": "On October 24, 2024, the National Security Council promoted an AI National Security Memorandum and linked coverage stating that the memo asks the military to increase its use of AI.",
     "sids": [
      "s5",
      "s4"
     ]
    },
    {
     "text": "The same day, it highlighted the release of AI guidelines for national security and intelligence agencies.",
     "sids": [
      "s3"
     ]
    },
    {
     "text": "It also referenced the Sustainable Development Goals through AI initiatives and credited U.S. re-engagement with UNESCO.",
     "sids": [
      "s2"
     ]
    }
   ]
  },
