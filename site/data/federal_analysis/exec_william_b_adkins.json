  "summary": {
   "status": "complete",
   "text": "In March 2026 testimony, William B. Adkins said continued investment in leading-edge research, including artificial intelligence, is needed to maintain U.S. technological advantage in space-based intelligence, surveillance, and reconnaissance. In an August 2026 reported statement, Adkins discussed leveraging AI tools to process data at speed and scale to support customers.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
