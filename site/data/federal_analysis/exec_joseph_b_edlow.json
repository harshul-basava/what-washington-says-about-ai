  "summary": {
   "status": "complete",
   "text": "In a May 28, 2025 written statement, Edlow said that if confirmed he would work with the USCIS and DHS chief information officers to ensure appropriate safeguards regarding AI use. He also stated that he was unaware of a specific USCIS policy on the use of AI tools across immigration agencies. Edlow said he believed the INA provides adequate mechanisms to attract international talent and ensure American competitiveness, and that he looked forward to following the INA as prescribed by Congress.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "In a May 28, 2025 written statement, Edlow said that if confirmed he would work with the USCIS and DHS chief information officers to ensure appropriate safeguards regarding AI use.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "He also stated that he was unaware of a specific USCIS policy on the use of AI tools across immigration agencies.",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "Edlow said he believed the INA provides adequate mechanisms to attract international talent and ensure American competitiveness, and that he looked forward to following the INA as prescribed by Congress.",
     "sids": [
      "s3"
     ]
    }
   ]
  },
