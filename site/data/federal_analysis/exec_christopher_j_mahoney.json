  },
  {
   "sid": "s10",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/mahoney_apq_responses1.pdf",
   "text": "Other factors include leveraging artificial intelligence, deepening the Joint Force’s knowledge through training and education on Electromagnetic Spectrum Operations, and working across the whole-of-government to evolve laws and regulations on the use of the EMSO internally and externally to the United States.",
   "source_type": "official_statement",
