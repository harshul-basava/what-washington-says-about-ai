  {
   "sid": "s12",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/mahoney_apq_responses1.pdf",
   "text": "There are currently 14 critical technology areas that we must focus on as a DOD to maximize the unparalleled strength and capabilities of our warfighters. These areas are: hypersonics; future generation wireless technology; advanced materials; integrated network systems-of-systems; directed energy; integrated sensing and cyber; space technology; quantum science; trusted artificial intelligence (AI) and autonomy; microelectronics; energy resilience; advanced computing and software; human-machine interfaces; and biotechnology.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Christopher J. Mahoney",
    "organization_id": "war",
    "basis": "manually_verified_written_answer",
