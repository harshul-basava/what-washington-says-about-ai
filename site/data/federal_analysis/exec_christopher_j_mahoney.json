  {
   "sid": "s6",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/mahoney_apq_responses1.pdf",
   "text": "The JWC also prioritizes emerging technologies like artificial intelligence and autonomous systems to enhance decision-making and operational effectiveness. By fostering interoperability among services and allied nations, the JWC supports a resilient and adaptable force capable of achieving strategic objectives in contested environments.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Christopher J. Mahoney",
    "organization_id": "war",
    "basis": "manually_verified_written_answer",
    "note": "The exact quote is in the named nominee answer after the exact question anchor and before the next numbered question."
   },
   "analysis": {
