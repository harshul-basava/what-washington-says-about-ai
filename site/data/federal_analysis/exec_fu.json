  },
  {
   "sid": "s14",
   "date": "2024-07-23",
   "url": "https://www.axios.com/pro/energy-policy/2024/07/23/ais-golden-moment",
   "text": "We think that this is really a critical, golden moment and opportunity to pair the demand from data centers for training AI",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Helena Fu",
    "organization_id": "energy",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
