   }
  },
  {
   "sid": "s13",
   "date": "2024-09-12",
   "url": "https://www.energy.gov/sites/default/files/2024-09/SENR%20Hearing%20HF%20AI%20Testimony_Final.pdf",
   "text": "U.S. leadership in critical and emerging technologies such as AI, biotechnology, quantum information science, and microelectronics is key to enabling economic prosperity and maintaining our national security.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Helena Fu",
    "organization_id": "energy",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
