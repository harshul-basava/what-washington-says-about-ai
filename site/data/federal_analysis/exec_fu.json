   }
  },
  {
   "sid": "s18",
   "date": "2024-09-12",
   "url": "https://www.energy.senate.gov/wp-content/uploads/media/doc/Fu%20Testimony%209-12-24%20SENR%20Cmte%20Hrg.pdf",
   "text": "DOE is already bringing our capabilities and expertise to bear in supporting the Executive Order on AI, from conducting red teaming, to evaluating the potential for AI to be misused for chemical, biological, radiological, and nuclear threats, to training an AI-ready science and engineering workforce through our National Laboratories, to building AI models to expedite environmental reviews and permitting.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Helena Fu",
    "organization_id": "energy",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
