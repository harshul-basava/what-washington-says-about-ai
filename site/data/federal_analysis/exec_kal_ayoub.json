  "summary": {
   "status": "complete",
   "text": "In April 2026 testimony, Kal Ayoub said rapid load growth, particularly from data centers and advanced manufacturing, is occurring at a speed and scale that challenges traditional planning processes, noting that data centers can be built faster than needed generation and transmission. Ayoub also said FERC is closely following emerging large load activity, including NERC efforts to identify and register large loads for reliability compliance and to develop new reliability standards addressing associated risks.",
   "sids": [
    "s1",
    "s2"
   ],
   "sentences": [
    {
     "text": "In April 2026 testimony, Kal Ayoub said rapid load growth, particularly from data centers and advanced manufacturing, is occurring at a speed and scale that challenges traditional planning processes, noting that data centers can be built faster than needed generation and transmission.",
