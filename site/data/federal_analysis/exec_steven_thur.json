  "summary": {
   "status": "complete",
   "text": "In a February 2025 post, Steven Thur said NOAA Research is actively incorporating AI into efforts to forecast extreme weather. In an August 2024 post, he described a system that uses artificial intelligence to rapidly and autonomously identify fires from geostationary satellite observations. In a May 2025 post, he posed a question about combining scientific ingenuity with satellite observations and AI.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "In a February 2025 post, Steven Thur said NOAA Research is actively incorporating AI into efforts to forecast extreme weather.",
     "sids": [
