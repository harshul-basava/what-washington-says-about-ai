 "statements": [
  {
   "sid": "s1",
   "date": "2024-04-16",
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/3759255/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "The Marine Corps is actively engaged, participating, and, in some instances, leading efforts within the Department of Defense’s Replicator Initiative, which aims to field attritable autonomous systems at scale and in multiple domains. To accomplish this task, the Marine Corps is aggressively leveraging AI, robotics, and commercial technology.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": "2024-04-16",
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/3759255/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "I see Replicator, if managed carefully, as an opportunity to build on the momentum of Force Design to accelerate modernization and alignment with the emergent needs of the Joint Force.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": null,
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/4186803/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "The integration of advanced sensors, the Family of Integrated Targeting Cells, artificial intelligence, Navy/Marine Expeditionary Ship Interdiction System (NMESIS), and one-way attack drones are greatly improving our ability to sense, make sense, and deliver precision fires.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s4",
   "date": null,
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/4186803/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "We are now moving to the next phase, Increment II, which adds advanced capabilities in electronic warfare, edge-based artificial intelligence, and improved satellite communications.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s5",
   "date": "2026-05-12",
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/4486636/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "Dynamis enables Artificial Intelligence-powered decision advantage by integrating commercial technologies with Marine Corps warfighting functions.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s6",
   "date": "2026-05-12",
   "url": "https://www.cmc.marines.mil/Speeches-and-Transcripts/Transcripts/Article/4486636/statement-of-general-eric-m-smith-commandant-of-the-marine-corps-on-the-posture/",
   "text": "The integration of MSS, now used by over 4,900 Marines, exemplifies the Corps' commitment to leveraging Artificial Intelligence to shape decision-making at all echelons, improving the Corps' joint kill chain capabilities in real-time operations.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Eric M. Smith",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
