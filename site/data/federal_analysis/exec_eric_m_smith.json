  },
  {
   "sid": "s7",
   "date": null,
   "url": "https://defensescoop.com/2025/01/15/marine-corps-commandant-gen-eric-smith-generative-ai-off-the-shelf-tools/",
   "text": "We’re not going to reorganize based on AI. We are going to use the tools that are available",
