  "summary": {
   "status": "complete",
   "text": "In a March 25, 2026 official statement, Taylor Jordan said NOAA had embraced AI and announced a suite of operational, AI-driven global weather prediction models. Jordan described NOAA as the first organization in the world to implement a hybrid physical-AI ensemble system and said the hybrid model provides probabilistic guidance on risk, uncertainty, and confidence. Jordan said the new models mark advances in forecast speed, efficiency, and accuracy while using a fraction of computational resources. Jordan also said AI will help establish NOAA as the world leader in Numerical Weather Prediction and improve broad access to NOAA's data.",
   "sids": [
    "s1",
    "s2",
    "s7",
    "s4",
    "s5"
   ],
   "sentences": [
    {
     "text": "In a March 25, 2026 official statement, Taylor Jordan said NOAA had embraced AI and announced a suite of operational, AI-driven global weather prediction models.",
