  "summary": {
   "status": "complete",
   "text": "In a February 24, 2026 reported statement, David Peters said chip smuggling is ongoing, that the issue is being actively addressed, and that it is among top enforcement priorities. In a June 12, 2025 official statement, he shared concern about potential unlawful transshipment or re-export of sensitive technologies to adversaries and noted that ECRA proscribes such conduct. In the same June 12, 2025 statement, he committed, if confirmed, to vigorous and fair enforcement and to considering the full range of ECRA and EAR penalties where appropriate.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "In a February 24, 2026 reported statement, David Peters said chip smuggling is ongoing, that the issue is being actively addressed, and that it is among top enforcement priorities.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "In a June 12, 2025 official statement, he shared concern about potential unlawful transshipment or re-export of sensitive technologies to adversaries and noted that ECRA proscribes such conduct.",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "In the same June 12, 2025 statement, he committed, if confirmed, to vigorous and fair enforcement and to considering the full range of ECRA and EAR penalties where appropriate.",
     "sids": [
      "s3"
     ]
    }
   ]
  },
