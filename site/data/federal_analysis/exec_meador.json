    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/meador-6b-ai_statement.pdf",
   "text": "In light of these troubling developments, I am pleased to support the Commission’s study of chatbot functions and behaviors, because it is imperative to ascertain whether and why frontier AI models are displaying these alleged behaviors.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Mark Meador",
    "organization_id": "ftc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
