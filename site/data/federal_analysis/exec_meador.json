   }
  },
  {
   "sid": "s7",
   "date": "2025-08-15",
   "url": "https://x.com/MeadorFTC/status/1956446313173938528",
   "text": "World-class, innovative AI doesn’t mean predatory AI. The American people deserve the truth about the endless experiments Big Tech has been running on vulnerable kids.",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Mark Meador",
    "basis": "verified_x_account",
    "account": "MeadorFTC",
    "user_id": "3974026329",
    "organization_id": "ftc",
    "role": "Commissioner, Federal Trade Commission"
   },
   "analysis": {
    "status": "pending",
