  },
  {
   "sid": "s6",
   "date": "2025-09-11",
   "url": "https://x.com/MeadorFTC/status/1966184060604264790",
   "text": "Today @FTC launched a major, sector-wide inquiry into the AI chatbots that more and more Americans--including children--use on a daily basis. https://t.co/fHJeYxNWkC",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Mark Meador",
    "basis": "verified_x_account",
    "account": "MeadorFTC",
    "user_id": "3974026329",
    "organization_id": "ftc",
    "role": "Commissioner, Federal Trade Commission"
   },
   "analysis": {
    "status": "pending",
    "a": {},
