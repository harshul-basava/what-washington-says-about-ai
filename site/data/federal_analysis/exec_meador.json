  },
  {
   "sid": "s4",
   "date": "2026-03-23",
   "url": "https://www.ftc.gov/system/files/ftc_gov/pdf/Antitrust-for-Digital-Markets-Forum-Meador.pdf",
   "text": "Artificial intelligence, digital platforms, and data-driven markets may present new factual settings. But the governing principles are long-standing and can be readily applied across different markets.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Mark Meador",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
