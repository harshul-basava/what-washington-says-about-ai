  },
  {
   "sid": "s3",
   "date": null,
   "url": "https://www.vitallaw.com/news/antitrust-news-ftc-commissioner-meador-delivers-remarks-highlighting-myths-in-antitrust-enforcement/ald013469b0da79d24ea89597102bff2faa33",
   "text": "When policymakers defer to powerful firms under the banner of national security, they achieve the opposite.",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Mark Meador",
    "organization_id": "ftc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
