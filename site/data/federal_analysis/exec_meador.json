 "statements": [
  {
   "sid": "s1",
   "date": "2025-09-11",
   "url": "https://search.ftc.gov/system/files/ftc_gov/pdf/meador-6b-ai_statement.pdf",
   "text": "For all their uncanny ability to simulate human cognition, these chatbots are products like any other, and those who make them available have a responsibility to comply with the consumer protection laws.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Mark Meador",
    "organization_id": "ftc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
