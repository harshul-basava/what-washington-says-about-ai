    "s5",
    "s7",
    "s8"
   ],
   "sentences": [
    {
     "text": "Frank Bisignano described artificial intelligence as a major efficiency opportunity and a strategic advantage.",
     "sids": [
      "s1",
      "s6"
     ]
    },
    {
     "text": "He said AI would be brought into the phone system and that the phone system must have AI to do the work.",
     "sids": [
      "s2",
      "s3"
     ]
    },
    {
     "text": "He said AI would bend the cost curve and be used throughout many processes, with a human responsible for validating results.",
     "sids": [
      "s4",
      "s5"
     ]
    },
    {
     "text": "In June 2025 testimony he cited accelerated AI investments to enhance employee productivity, and in March 2026 he said AI would be part of increasing the compliance rate.",
     "sids": [
      "s7",
      "s8"
     ]
    }
   ]
