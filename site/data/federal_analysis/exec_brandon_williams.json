  {
   "sid": "s5",
   "date": "2025-12-01",
   "url": "https://www.energy.gov/nnsa/articles/nnsa-demonstrates-swift-action-genesis-mission",
   "text": "NNSA is at the forefront of leveraging cutting-edge technology to safeguard our nation,” said NNSA Administrator Brandon Williams. “President Trump’s Genesis Mission provides a clear mandate, and we are responding with immediate action. This RFI is a critical step in harnessing the immense power of AI to enact the White House’s vision for America to lead in every aspect of AI.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
    "organization_id": "energy",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
