   "date": null,
   "url": "https://govciomedia.com/nnsa-chief-warns-ai-race-demands-government-move-faster/",
   "text": "We can no longer have a five to seven year procurement cycle. We just wouldn’t be able to keep up,",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
    "organization_id": "energy",
