   }
  },
  {
   "sid": "s4",
   "date": "2026-07-20",
   "url": "https://www.energy.gov/nnsa/articles/nnsa-selects-amentum-ai-data-center-and-energy-project-savannah-river-site",
   "text": "By working with the private sector, we can move faster, apply innovative technologies, and make productive use of federal land while maintaining our commitment to mission delivery.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
