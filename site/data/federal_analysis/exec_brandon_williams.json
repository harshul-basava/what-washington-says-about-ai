  },
  {
   "sid": "s3",
   "date": "2026-07-20",
   "url": "https://www.energy.gov/nnsa/articles/nnsa-selects-amentum-ai-data-center-and-energy-project-savannah-river-site",
   "text": "This proposed partnership represents an opportunity to strengthen America’s leadership in artificial intelligence, expand reliable energy generation, and strengthen our national security,",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
    "organization_id": "energy",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
