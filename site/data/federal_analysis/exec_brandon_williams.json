   }
  },
  {
   "sid": "s6",
   "date": "2025-12-01",
   "url": "https://www.energy.gov/nnsa/articles/nnsa-demonstrates-swift-action-genesis-mission",
   "text": "Our response to the Genesis Mission is a testament to NNSA’s dedication to innovation and our unwavering commitment to national security,” Administrator Williams added. “We are ready to work with the brightest minds across the nation to ensure that America continues to lead in AI and its critical applications.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
    "organization_id": "energy",
    "basis": "local_span",
