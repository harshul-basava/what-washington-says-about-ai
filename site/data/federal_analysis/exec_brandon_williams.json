  },
  {
   "sid": "s2",
   "date": null,
   "url": "https://www.foxnews.com/politics/trump-admin-unveils-11-foot-tall-ai-designed-nuclear-test-flight-vehicle-great-american-state-fair",
   "text": "There's no question that we're in an AI capabilities race with China.",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Brandon Williams",
    "organization_id": "energy",
    "basis": "local_span",
