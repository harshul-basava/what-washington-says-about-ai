  "summary": {
   "status": "complete",
   "text": "Seval Oz, as USDOT Assistant Secretary for Research and Technology, said the department is using advanced AI to lower costs and transform the lifecycle of physical transportation infrastructure. She said USDOT should and will become a launchpad for new AI-driven technology and called for developing AI models built on the American automation stack to make U.S. transportation a global gold standard. She described efforts to create open-source backend infrastructure to enable interoperability across states and said she has advised top AI and data science teams to assess transformative technology frontiers. She also said transportation safety, which she described as her office's responsibility, is bleeding into national security.",
   "sids": [
    "s1",
    "s7",
    "s3",
    "s4",
    "s8",
    "s5",
    "s6",
    "s2"
   ],
   "sentences": [
    {
     "text": "Seval Oz, as USDOT Assistant Secretary for Research and Technology, said the department is using advanced AI to lower costs and transform the lifecycle of physical transportation infrastructure.",
     "sids": [
      "s1",
      "s7"
     ]
    },
    {
     "text": "She said USDOT should and will become a launchpad for new AI-driven technology and called for developing AI models built on the American automation stack to make U.S. transportation a global gold standard.",
     "sids": [
      "s3",
      "s4",
      "s8"
     ]
    },
    {
     "text": "She described efforts to create open-source backend infrastructure to enable interoperability across states and said she has advised top AI and data science teams to assess transformative technology frontiers.",
     "sids": [
      "s5",
      "s6"
     ]
    },
    {
     "text": "She also said transportation safety, which she described as her office's responsibility, is bleeding into national security.",
     "sids": [
      "s2"
     ]
    }
   ]
  },
