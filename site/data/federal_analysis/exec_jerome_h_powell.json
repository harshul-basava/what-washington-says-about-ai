  },
  {
   "sid": "s2",
   "date": "2026-01-28",
   "url": "https://www.federalreserve.gov/mediacenter/files/FOMCpresconf20260128.pdf",
   "text": "So everyone, of course, is watching AI and the deployment and trying to understand exactly what’s happening, and there’s a wide range of possibilities. It’s hard to say, and of course anyone who uses it is amazed at what it can accomplish, right?",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Jerome H. Powell",
    "organization_id": "federal_reserve",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "speaker_label": "CHAIR POWELL.",
    "speaker_identity_source_url": "https://www.federalreserve.gov/aboutthefed/bios/board/powell.htm",
    "speaker_alias_verified_on": "2026-11-11"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": "2026-01-28",
   "url": "https://www.federalreserve.gov/mediacenter/files/FOMCpresconf20260128.pdf",
   "text": "And we may, in any case, see, in the short term, jobs that are being eliminated by the capabilities of AI. We may see that. We just don’t know what the overall effect is going to be.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Jerome H. Powell",
    "organization_id": "federal_reserve",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "speaker_label": "CHAIR POWELL.",
    "speaker_identity_source_url": "https://www.federalreserve.gov/aboutthefed/bios/board/powell.htm",
    "speaker_alias_verified_on": "2026-11-11"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
