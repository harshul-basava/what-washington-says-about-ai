 "statements": [
  {
   "sid": "s1",
   "date": "2026-01-28",
   "url": "https://www.federalreserve.gov/mediacenter/files/FOMCpresconf20260128.pdf",
   "text": "And we’re benefiting from the—from the AI buildout of data centers—that’s another thing we’re benefiting from.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Jerome H. Powell",
    "organization_id": "federal_reserve",
    "basis": "local_span",
