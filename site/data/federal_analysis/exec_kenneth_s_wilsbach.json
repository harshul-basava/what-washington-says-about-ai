  {
   "sid": "s3",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/wilsbach_apq_responses.pdf",
   "text": "The Air Force is leading a joint effort to implement Advanced Wargaming, a transformative initiative that will integrate models from across the Department of War and the Intelligence Community. This effort will augment human decision-making with artificial intelligence and provide our warfighters with access to high-powered computing resources.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Kenneth S. Wilsbach",
    "organization_id": "war",
    "basis": "manually_verified_written_answer",
    "note": "Manual review of the named nominee response; the quote is in the answer after the question and before the next numbered question."
   },
   "analysis": {
