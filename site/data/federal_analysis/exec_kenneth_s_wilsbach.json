  },
  {
   "sid": "s5",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/wilsbach_apq_responses.pdf",
   "text": "The USAF and USSF investments in EW are strategically focused on distributed, software-defined systems and capabilities, fostering agility and increasingly leveraging the power of Artificial Intelligence and Machine Learning. By developing these more robust, adaptive, and cognitive electronic warfare capabilities, coupled with innovative concepts and doctrine, we will empower the Joint Force to effectively maneuver and decisively succeed within all domains.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Kenneth S. Wilsbach",
    "organization_id": "war",
    "basis": "manually_verified_written_answer",
    "note": "Manual review of the named nominee response; the quote is in the answer after the question and before the next numbered question."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
