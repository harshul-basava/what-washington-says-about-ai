  },
  {
   "sid": "s4",
   "date": null,
   "url": "https://www.armed-services.senate.gov/imo/media/doc/wilsbach_apq_responses.pdf",
   "text": "The Air Force will continue to collaborate with industry experts on experimentation in artificial intelligence and machine learning, providing innovative solutions to help achieve decision advantage through the optimal balance of human-machine teaming.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Kenneth S. Wilsbach",
    "organization_id": "war",
    "basis": "manually_verified_written_answer",
    "note": "Manual review of the named nominee response; the quote is in the answer after the question and before the next numbered question."
   },
