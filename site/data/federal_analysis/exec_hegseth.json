  {
   "sid": "s16",
   "date": "2026-01-12",
   "url": "https://www.war.gov/News/Transcripts/Transcript/Article/4377190/remarks-by-secretary-of-war-pete-hegseth-at-spacex/",
   "text": "Third, compute resource. We will invest heavily in expanding our access to AI compute from data centers to the tactical edge, and we'll tap into hundreds of billions of dollars in private capital flowing into American AI. President Trump's executive order has directed us to build data centers on military land and to work with the Department of Energy to ensure that we dramatically increase the number and breadth of resources needed to power this computing infrastructure.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Pete Hegseth",
    "organization_id": "war",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
