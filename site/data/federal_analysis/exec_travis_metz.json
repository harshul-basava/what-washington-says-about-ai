  "summary": {
   "status": "complete",
   "text": "In an August 2026 statement, Travis Metz said that those at Fort Benning who had a version of the technology on the edge performed most highly. In June 2026, he said 30,000 drones had been ordered and were being delivered, with 60,000 more to be ordered in September. In October 2026, he said these drones are going to mostly do the thing on their own.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
