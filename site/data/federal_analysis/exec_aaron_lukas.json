  {
   "sid": "s3",
   "date": null,
   "url": "https://www.intelligence.senate.gov/wp-content/uploads/2025/05/aphq-alukas-040925_0.pdf",
   "text": "Emerging technology: The convergence of emerging and disruptive tech—like AI, quantum computing, and autonomous systems—will shape the future of intelligence. Integrating these technologies in ways that advance the IC’s ability to stay ahead of our adversaries represents a major challenge that will require ODNI leadership.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Aaron Lukas",
    "organization_id": "odni",
    "basis": "manually_verified_written_answer",
    "note": "Manual review of the named nominee written answer. The complete quote occurs after its exact question anchor and before the next question anchor. Preserve the source extraction spacing."
   },
