  {
   "sid": "s2",
   "date": null,
   "url": "https://www.intelligence.senate.gov/wp-content/uploads/2025/05/aphq-alukas-040925_0.pdf",
   "text": "Examples include the shift of focus to counter Chinese aggression and espi onage, which came years later that it should have, and the current slowness in adopting AI to the intelligence business. The IC currently lags far behind the private sector, and increasingly behind America’s adversaries, in adopting this game-changing technology.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Aaron Lukas",
    "organization_id": "odni",
    "basis": "manually_verified_written_answer",
    "note": "Manual review of the named nominee written answer. The complete quote occurs after its exact question anchor and before the next question anchor. Preserve the source extraction spacing."
   },
