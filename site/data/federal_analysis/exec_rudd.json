 "statements": [
  {
   "sid": "s1",
   "date": "2026-04-16",
   "url": "https://armedservices.house.gov/uploadedfiles/gen_rudd_witness_statement.pdf",
   "text": "The research and development of AI tools is a constant, not an exception, as it helps us stay ahead of our foreign adversaries who are also working feverishly to develop AI tools for their own benefit.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Joshua Rudd",
    "organization_id": "nsa",
    "note": "",
    "role": "Director, National Security Agency"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": null,
   "url": "https://exa.ai/library/podcast/ssvxycb6tjw/episode/c3b8wdyncy0",
   "text": "It will make us faster. It'll make us more effective in what we do",
   "source_type": "reported_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Joshua Rudd",
    "organization_id": "nsa",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
