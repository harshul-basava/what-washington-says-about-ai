  "summary": {
   "status": "complete",
   "text": "In August 2025 remarks as Vice Chair for Supervision, Michelle W. Bowman said she was encouraged by bank AI adoption and ongoing investments in AI and machine learning. She also said changes ideally would occur with regulators' willing embrace, allowing AI use cases to proliferate in a way that benefits the banking system. In November 2024 remarks, she said AI must comply with existing laws and regulations and is not exempt from scrutiny, while also saying banks' ability to innovate should be preserved and regulators should understand AI before changing their regulatory approach.",
   "sids": [
    "s1",
    "s2",
    "s3",
    "s4",
    "s5",
    "s6"
   ],
   "sentences": [
    {
     "text": "In August 2025 remarks as Vice Chair for Supervision, Michelle W. Bowman said she was encouraged by bank AI adoption and ongoing investments in AI and machine learning.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "She also said changes ideally would occur with regulators' willing embrace, allowing AI use cases to proliferate in a way that benefits the banking system.",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "In November 2024 remarks, she said AI must comply with existing laws and regulations and is not exempt from scrutiny, while also saying banks' ability to innovate should be preserved and regulators should understand AI before changing their regulatory approach.",
     "sids": [
      "s3",
      "s4",
      "s5",
      "s6"
     ]
    }
   ]
