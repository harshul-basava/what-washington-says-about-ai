  "summary": {
   "status": "complete",
   "text": "FERC Chairman Laura V. Swett said she is committed to guiding FERC through the \"monumental growth opportunity\" before it. Swett described a December 2025 order as a step toward fortifying national and economic security in the AI revolution while preserving just and reasonable rates. She said clarifying rules would help release a bottleneck of large load investments across the PJM footprint. She also said her priority as chairman is to ensure the country can connect and power data centers as quickly and durably as possible.",
   "sids": [
    "s1",
    "s2",
    "s3",
    "s6"
   ],
   "sentences": [
    {
     "text": "FERC Chairman Laura V. Swett said she is committed to guiding FERC through the \"monumental growth opportunity\" before it.",
     "sids": [
      "s1"
     ]
    },
    {
     "text": "Swett described a December 2025 order as a step toward fortifying national and economic security in the AI revolution while preserving just and reasonable rates.",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "She said clarifying rules would help release a bottleneck of large load investments across the PJM footprint.",
     "sids": [
      "s3"
     ]
    },
    {
     "text": "She also said her priority as chairman is to ensure the country can connect and power data centers as quickly and durably as possible.",
     "sids": [
      "s6"
     ]
    }
   ]
