  {
   "sid": "s9",
   "date": null,
   "url": "https://www.state.gov/biographies/adam-cassady",
   "text": "Adam Cassady was appointed Ambassador at Large for Cyberspace and Digital Policy at the U.S. Department of State on August 7, 2026. He took his oath of office and assumed his duties on August 24, 2026. In this capacity, he advances U.S. leadership abroad in critical and emerging technologies, including artificial intelligence (AI), autonomy, quantum, biotechnology, telecommunications, next generation communications, related critical infrastructure, and export diplomacy related to these topics.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "local_span",
