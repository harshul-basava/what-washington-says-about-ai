 "statements": [
  {
   "sid": "s1",
   "date": "2026-04-16",
   "url": "https://www.foreign.senate.gov/imo/media/doc/85aca2f2-f79c-4d26-73c3-b128a911f792/041626_Cassady_Testimony.pdf",
   "text": "We are living through a technological transformation that will fundamentally reorder the global economy. Artificial intelligence, advanced semiconductors, quantum computing, biotechnology, autonomy, robotics, related critical infrastructure, and next-generation telecommunications will shape productivity, military power, supply chains, and global standards for decades to come.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": null,
   "url": "https://www.ntia.gov/speech/testimony/2025/remarks-principal-deputy-assistant-secretary-adam-cassady-nvidia-gtc",
   "text": "In AI, NTIA’s vision is just that of the Administration’s: we want the United States-led AI to power the future. Of work, of recreation, of life.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": "2025-10-29",
   "url": "https://www.ntia.gov/speech/testimony/2025/remarks-principal-deputy-assistant-secretary-adam-cassady-nvidia-gtc",
   "text": "AI will shape how 6G works under the hood— optimizing networks, predicting failures, dynamically allocating spectrum— and 6G will, in turn, shape how AI reaches the edge. It’s a feedback loop between intelligence and connectivity, and the countries that understand that relationship first will define the next digital era.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s4",
   "date": "2025-10-29",
   "url": "https://www.ntia.gov/speech/testimony/2025/remarks-principal-deputy-assistant-secretary-adam-cassady-nvidia-gtc",
   "text": "AI-driven networks are table stakes for competitiveness in the future. If you aren’t leaning forward, you’re already behind.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
