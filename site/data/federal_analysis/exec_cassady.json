   }
  },
  {
   "sid": "s8",
   "date": "2026-04-16",
   "url": "https://www.foreign.senate.gov/imo/media/doc/85aca2f2-f79c-4d26-73c3-b128a911f792/041626_Cassady_Testimony.pdf",
   "text": "The nation that leads in innovating, deploying, and securing these technologies will shape the rules of the international system deep into the 21st century.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Adam Cassady",
    "organization_id": "state_cdp",
    "basis": "local_span",
