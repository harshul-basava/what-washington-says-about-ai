  {
   "sid": "s6",
   "date": "2026-06-25",
   "url": "https://healthit.gov/wp-content/uploads/2026/06/HHS-Accelerating-the-Adoption-of-Clinical-AI-RFI-event-transcript.pdf",
   "text": "And then, as well, in economic security, we want to apply AI to things like Trump accounts, where people can go and search into things like TrumpRx, ABLE accounts, which is a 529-type plan for people with disabilities.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Mary Lazare",
    "organization_id": "acl",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
