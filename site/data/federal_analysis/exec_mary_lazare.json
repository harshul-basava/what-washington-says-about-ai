  "summary": {
   "status": "complete",
   "text": "Mary Lazare, Administrator of ACL, stated that the agency is using a prize competition to identify technologies that empower caregivers and expand access to high-quality care at home (s1, s2). She noted that these initiatives aim to reduce caregiver burnout and address unintentional neglect (s2). Additionally, she mentioned exploring AI applications involving wearables and home modifications to help people remain in their homes (s3).",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "Mary Lazare, Administrator of ACL, stated that the agency is using a prize competition to identify technologies that empower caregivers and expand access to high-quality care at home (s1, s2).",
     "sids": [
      "s1",
      "s2"
     ]
    },
    {
     "text": "She noted that these initiatives aim to reduce caregiver burnout and address unintentional neglect (s2).",
     "sids": [
      "s2"
     ]
    },
    {
     "text": "Additionally, she mentioned exploring AI applications involving wearables and home modifications to help people remain in their homes (s3).",
     "sids": [
      "s3"
     ]
    }
   ]
