   }
  },
  {
   "sid": "s10",
   "date": "2025-04-05",
   "url": "https://www.armed-services.senate.gov/download/hansell-apq-responses?download=1",
   "text": "Adversary investment in advanced technologies such as artificial intelligence, quantum computing, and encrypted communications, as well as the dispersion of sophisticated capabilities across the globe, have complicated the information environment and reduced our national security advantage.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Bradley D. Hansell",
    "organization_id": "war_is",
    "basis": "manually_verified_written_answer",
