  {
   "sid": "s2",
   "date": "2025-03-25",
   "url": "https://www.bis.gov/news-updates",
   "text": "Under the strong leadership of President Donald Trump, the Commerce Department is taking decisive action to protect America. We will not allow adversaries to exploit American technology to bolster their own militaries and threaten American lives,",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Howard Lutnick",
    "organization_id": "commerce",
    "note": "Exact excerpt from the current BIS news page; the date is the release date.",
    "role": "Secretary of Commerce"
