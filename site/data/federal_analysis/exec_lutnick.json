   "sid": "s1",
   "date": "2026-04-01",
   "url": "https://www.trade.gov/press-release/department-commerce-begins-inaugural-call-proposals-american-ai-exports-program",
   "text": "The American AI Exports Program delivers on President Trump’s directive to ensure that American AI systems – built on trusted hardware, secure data, and world-leading innovation – are deployed at scale around the world,",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Howard Lutnick",
    "organization_id": "commerce",
    "note": "",
    "role": "Secretary of Commerce"
   },
