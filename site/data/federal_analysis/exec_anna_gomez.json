 "statements": [
  {
   "sid": "s1",
   "date": "2024-02-02",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-17A4.txt",
   "text": "Responsible and ethical implementation of AI technologies is crucial to strike a balance, ensuring that the benefits of AI are harnessed to protect consumers from harm rather than amplify the risks they face in an increasingly digital landscape.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-74A5.txt",
   "text": "There is no getting around the fact that AI has fast become an integral element of almost every business, including advertising.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-74A5.txt",
   "text": "What this proceeding does not do is propose a restriction or ban on the use of AI-generated content in political ads. The purpose is to make certain that listeners and viewers are informed when political ads include such content.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s4",
   "date": "2024-08-07",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-84A6.txt",
   "text": "We voted on proposals to ensure that AI is harnessed to protect consumers from harm rather than amplify the risks they experience in the robocall and robotext context.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s5",
   "date": "2024-08-07",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-84A6.txt",
   "text": "AI technologies can bring both new challenges and opportunities to combat this scourge, and responsible and ethical implementation of AI technologies is crucial to strike a balance.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s6",
   "date": "2024-08-07",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-84A6.txt",
   "text": "I am glad that we are seeking comment on ways that consumers can become aware of when they are receiving communications generated with AI. We serve consumers best when we arm them with information.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s7",
   "date": "2024-02-02",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-17A4.txt",
   "text": "Today, the Commission confirms that the Telephone Consumer Protection Act’s prohibition on using “artificial or prerecorded voice” to make robocalls and robotexts without prior express consent of the receiving party includes AI technologies that generate human voices, such as voice cloning.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s8",
   "date": "2024-02-02",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-17A4.txt",
   "text": "This Declaratory Ruling is particularly important to prevent fraudsters from using AI to prey on consumers.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s9",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-74A5.txt",
   "text": "Political and issue advertisements can be a critical channel for political candidates and other stakeholders to share their message with the listening and viewing public and thus an important form of civic engagement",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s10",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-25-46A3.txt",
   "text": "After all, for communities to benefit from the AI revolution, they must have the bandwidth that meets the high-capacity needs that AI data centers demand.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s11",
   "date": "2025-09-30",
   "url": "https://docs.fcc.gov/public/attachments/FCC-25-67A3.txt",
   "text": "States can be important test labs for what may or may not work with emerging technologies like this one.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s12",
   "date": "2025-09-30",
   "url": "https://docs.fcc.gov/public/attachments/FCC-25-67A3.txt",
   "text": "Not to mention, our authority in this area is dubious at best, particularly after recent court decisions limiting our authority.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s13",
   "date": "2024-02-02",
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-17A4.txt",
   "text": "Artificial Intelligence (AI) technologies can bring both new challenges to the security of our communications and opportunities to combat robocalls and robotexts.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Commissioner"
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s14",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-24-74A5.txt",
   "text": "This order initiates a proceeding to consider providing greater transparency regarding the use of AI-generated content in political advertising.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s15",
   "date": null,
   "url": "https://docs.fcc.gov/public/attachments/FCC-25-46A3.txt",
   "text": "Just last week, this Administration released an AI plan that looked at “winning the AI race” in ways that would “usher in a new golden age” of “economic competitiveness and national security for the American people.” I wonder how that plan will square with the changes this FCC is envisioning in how it measures broadband deployment in this country.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s16",
   "date": "2025-09-30",
   "url": "https://docs.fcc.gov/public/attachments/FCC-25-67A3.txt",
   "text": "Finally, thank you to the Office of the Chairman for incorporating my edits to this item, including seeking comment about our legal authority regarding Artificial Intelligence.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s17",
   "date": "2026-01-14",
   "url": "https://democrats-energycommerce.house.gov/sites/evo-subsites/democrats-energycommerce.house.gov/files/evo-media-document/witness-testimony_fcc-oversight_gomez_01.14.2026-2.pdf",
   "text": "Leadership in AI and other investments should not be measured by how many miles of fiber we lay or how many data centers we build, but by whether people can actually connect, participate, and benefit from a new digital economy.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Anna Gomez",
    "organization_id": "fcc",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
