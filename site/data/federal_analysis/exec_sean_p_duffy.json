  },
  {
   "sid": "s4",
   "date": "2026-09-25",
   "url": "https://x.com/SecDuffy/status/2103507985066512478",
   "text": "you SMART - a new artificial intelligence tool for air traffic managers to plan around bad weather and reroute flight paths around the storms\n\nFamily",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Sean P. Duffy",
    "basis": "verified_x_account",
    "account": "SecDuffy",
    "user_id": "1883853671148167168",
