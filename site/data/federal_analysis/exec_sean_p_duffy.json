 "statements": [
  {
   "sid": "s1",
   "date": "2026-10-13",
   "url": "https://x.com/SecDuffy/status/2109997045868118511",
   "text": "Here’s what the @FAANews new artificial intelligence tool means for you: Less delays, less cancellations, and less fuel burn - which will save BILLIONS of",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Sean P. Duffy",
    "basis": "verified_x_account",
    "account": "SecDuffy",
    "user_id": "1883853671148167168",
    "organization_id": "transportation",
    "role": "Secretary of Transportation"
   },
   "analysis": {
    "status": "pending",
    "a": {},
