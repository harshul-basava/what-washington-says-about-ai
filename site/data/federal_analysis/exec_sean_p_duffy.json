  },
  {
   "sid": "s6",
   "date": "2026-09-22",
   "url": "https://x.com/SecDuffy/status/2102443493419373047",
   "text": "Trajectories - is our new AI tool:\n\n✅ Pulls 200 data streams into 1 platform \n✅ Prevents delays & cancellations before they happen \n✅ Reduces",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Sean P. Duffy",
    "basis": "verified_x_account",
