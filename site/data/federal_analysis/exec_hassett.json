  "summary": {
   "status": "complete",
   "text": "Hassett described AI-driven societal changes as beneficial, anticipating higher wages and greater opportunities for leisure. On September 28, 2026, he emphasized AI's growth benefits and argued that labor-market stress was concentrated at firms not adopting it. In another supplied excerpt, he said AI productivity gains could reduce firms' need to hire new college graduates. He characterized AI risks as solvable by the private sector, with government monitoring and law enforcement when necessary.",
   "sids": [
    "s6",
    "s7",
    "s3",
    "s4"
   ],
   "sentences": [
    {
     "text": "Hassett described AI-driven societal changes as beneficial, anticipating higher wages and greater opportunities for leisure.",
     "sids": [
      "s6"
     ]
    },
    {
     "text": "On September 28, 2026, he emphasized AI's growth benefits and argued that labor-market stress was concentrated at firms not adopting it.",
     "sids": [
      "s7"
     ]
    },
    {
     "text": "In another supplied excerpt, he said AI productivity gains could reduce firms' need to hire new college graduates.",
     "sids": [
      "s3"
     ]
    },
    {
     "text": "He characterized AI risks as solvable by the private sector, with government monitoring and law enforcement when necessary.",
     "sids": [
      "s4"
     ]
    }
   ]
  },
