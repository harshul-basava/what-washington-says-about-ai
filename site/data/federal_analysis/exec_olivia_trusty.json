  {
   "sid": "s8",
   "date": "2026-03-18",
   "url": "https://x.com/OliviaTrustyFCC/status/2034339546893312356",
   "text": "In the Age of AI, the rule book for our workforce has changed—success requires continuous learning, new skills, and strong connectivity.  At the @FCC, we’re",
   "source_type": "x",
   "attribution": {
    "kind": "official_role",
    "speaker": "Olivia Trusty",
    "basis": "verified_x_account",
    "account": "OliviaTrustyFCC",
