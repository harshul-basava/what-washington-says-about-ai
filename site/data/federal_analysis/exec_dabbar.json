  },
  {
   "sid": "s5",
   "date": "2023-10-19",
   "url": "https://www.congress.gov/118/meeting/house/116494/witnesses/HHRG-118-IF03-Wstate-DabbarP-20231019.pdf",
   "text": "Under the leadership of Secretaries Perry and Brouillette, the U.S. built the first high performance computer built specifically for what has become the AI revolution. That computer, named Summit, was built under the authorization of this committee at Oak Ridge National Lab. DOE developed a computer to integrate GPU and CPU chips, to build a first of a kind supercomputer designed for AI. That commissioning also allowed the U.S. to regain our #1 global supercomputer position from Communist China.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
