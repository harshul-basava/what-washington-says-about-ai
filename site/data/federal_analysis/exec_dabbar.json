    "assessments": {}
   }
  },
  {
   "sid": "s7",
   "date": "2025-12-22",
   "url": "https://www.nist.gov/news-events/news/2025/12/nist-launches-centers-ai-manufacturing-and-critical-infrastructure",
   "text": "This investment will help accelerate the application of AI in American manufacturing and help drive the American manufacturing renaissance",
   "source_type": "official_statement",
   "attribution": {
    "kind": "official_role",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source.",
    "role": "Deputy Secretary of Commerce"
   },
   "analysis": {
    "status": "pending",
