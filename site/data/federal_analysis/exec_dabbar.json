    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s14",
   "date": "2025-05-01",
   "url": "https://www.govinfo.gov/content/pkg/CHRG-119shrg62324/html/CHRG-119shrg62324.htm",
   "text": "If confirmed, I would prioritize utilizing AI to increase U.S. competitiveness by advancing energy innovation. While at the DOE, I had the opportunity to oversee a partnership using AI to increase discovery of energy technologies, and there are many other similar opportunities for innovation.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
