 "statements": [
  {
   "sid": "s1",
   "date": "2023-10-19",
   "url": "https://www.congress.gov/118/meeting/house/116494/witnesses/HHRG-118-IF03-Wstate-DabbarP-20231019.pdf",
   "text": "National security can be placed at risk with the new hardware and software deployment. Communist China can place physical back doors on their chips, and holes in AI algorithms, to allow sabotage.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s2",
   "date": "2023-10-19",
   "url": "https://www.congress.gov/118/meeting/house/116494/witnesses/HHRG-118-IF03-Wstate-DabbarP-20231019.pdf",
   "text": "I would recommend that we ban all chips, software, electric vehicle components, and power grid controls from China today.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": "2023-10-19",
   "url": "https://www.congress.gov/118/meeting/house/116494/witnesses/HHRG-118-IF03-Wstate-DabbarP-20231019.pdf",
   "text": "I would recommend this committee direct efforts for your departments of jurisdiction to implement these in government, like the private sector is beginning to do.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "personal",
    "speaker": "Paul Dabbar",
    "organization_id": "commerce",
    "basis": "document_author",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
