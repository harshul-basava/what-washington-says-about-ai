  "summary": {
   "status": "complete",
   "text": "In a September 20, 2025 post, Andre Barbe stated that directive automation had jumped from 27% to 39% in nine months. In a January 30, 2023 statement, he said he would advise and draft legislation on technology policy, especially artificial intelligence. In a May 2022 publication, he stated that export controls on advanced semiconductor manufacturing equipment were among the most important tools available to sustain China's chip dependence.",
   "sids": [
    "s1",
    "s2",
    "s3"
   ],
   "sentences": [
    {
     "text": "In a September 20, 2025 post, Andre Barbe stated that directive automation had jumped from 27% to 39% in nine months.",
