  {
   "sid": "s2",
   "date": "2023-11-02",
   "url": "https://media.defense.gov/2023/Nov/02/2003333301/-1/-1/1/DAAIS_FACTSHEET.PDF",
   "text": "This 2023 DoD Data, Analytics, and AI Adoption Strategy builds upon and supersedes the 2018 AI Strategy and the 2020 Data Strategy to continue the Department’s digital transformation.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
