    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s3",
   "date": "2023-11-02",
   "url": "https://media.defense.gov/2023/Nov/02/2003333301/-1/-1/1/DAAIS_FACTSHEET.PDF",
   "text": "The Department will focus strategic efforts on several interdependent goals that support the DoD AI Hierarchy of Needs.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s4",
   "date": "2023-11-02",
   "url": "https://media.defense.gov/2023/Nov/02/2003333301/-1/-1/1/DAAIS_FACTSHEET.PDF",
   "text": "At the top of the pyramid is Responsible AI, the Department’s dynamic approach to the design, development, and use of AI capabilities that is consistent with the DoD AI Ethical Principles.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
