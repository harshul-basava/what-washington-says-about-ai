   }
  },
  {
   "sid": "s5",
   "date": "2023-06-27",
   "url": "https://media.defense.gov/2023/nov/02/2003333300/-1/-1/1/dod_data_analytics_ai_adoption_strategy.pdf",
   "text": "The Department will focus strategic efforts on several interdependent goals that support the DoD AI Hierarchy of Needs (Figure 2). The AI Hierarchy of Needs is a pyramid with quality data as its foundation since all analytic and AI capabilities require trusted, high-quality data to support decision makers.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s6",
   "date": "2023-06-27",
   "url": "https://media.defense.gov/2023/nov/02/2003333300/-1/-1/1/dod_data_analytics_ai_adoption_strategy.pdf",
   "text": "The layers of the Hierarchy are supported by robust sets of processes. Increased data quality and insightful analytics are achievable through effective enterprise data governance. Sound assurance processes for testing, evaluation, validation, and verification are imperative for Responsible AI.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
   "analysis": {
    "status": "pending",
    "a": {},
    "b": {},
    "topics": [],
    "confidence": {},
    "escalated": [],
    "models": {},
    "assessments": {}
   }
  },
  {
   "sid": "s7",
   "date": "2023-06-27",
   "url": "https://media.defense.gov/2023/nov/02/2003333300/-1/-1/1/dod_data_analytics_ai_adoption_strategy.pdf",
   "text": "The Hierarchy is helpful as a framework for assessing DoD AI readiness, and for guiding the Department’s goals to accelerate adoption of data, analytics, and AI technologies to build enduring decision advantage.",
   "source_type": "official_statement",
   "attribution": {
    "kind": "institutional",
    "speaker": "Department of War / Defense",
    "organization_id": "war",
    "basis": "local_span",
    "note": "Automated extraction; exact quote and attribution span matched the retrieved source."
   },
