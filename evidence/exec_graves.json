      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s23",
      "added": "2026-11-09"
    },
    {
      "text": "discuss our need to deepen cooperation on export controls with a focus on impact, and our bilateral relations around critical &amp; emerging technology. https://t.co/XgSXZODllw https://t.co/mwsPWInEsW",
      "date": "2023-03-01",
      "date_quote": "2023-03-01T02:25:35.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1630756137317584896",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
        "account": "DepSecGraves",
        "user_id": "1392831444616101888",
        "organization_id": "commerce",
        "role": "Deputy Secretary of Commerce"
      },
      "retrieved_on": "2026-11-09",
      "source_text_sha256": "fb51fc2b7620829a83431b75f602ce86370f22744486416b885faf6263e862c9",
      "origin": "federal_x",
      "post_id": "1630756137317584896",
      "account_source_url": "https://www.commerce.gov/news/press-releases/2021/05/don-graves-sworn-deputy-secretary-commerce",
      "excerpted": true,
      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s24",
      "added": "2026-11-09"
    },
    {
      "text": "and Customs Union @gerass_thomas to discuss 🇺🇸-🇪🇺 cooperation on the Ukraine crisis, including operationalizing enforcement of our mutual Russian sanctions and export controls. https://t.co/AqMR5gfbfU https://t.co/ZS6G5Q2W7Y",
      "date": "2023-02-28",
      "date_quote": "2023-02-28T22:34:42.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1630698033368412161",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
        "account": "DepSecGraves",
        "user_id": "1392831444616101888",
