      "origin": "federal_x",
      "post_id": "1638981881042706433",
      "account_source_url": "https://www.commerce.gov/news/press-releases/2021/05/don-graves-sworn-deputy-secretary-commerce",
      "excerpted": true,
      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s22",
      "added": "2026-11-09"
    },
    {
      "text": "leadership and continued coordination on export controls against Russia’s unprovoked war in Ukraine. U.S. partnership with the European Union is stronger than ever. https://t.co/vk9zwybtKQ https://t.co/HYzPoTdnW2",
      "date": "2023-03-10",
      "date_quote": "2023-03-10T20:50:00.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1634295561464561667",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
