      "source_text_sha256": "ff6446cfee9368d9bd02ae271e3b2822b9a7f7688ee344f2580b0958f451d077",
      "origin": "federal_x",
      "post_id": "1629222385022013440",
      "account_source_url": "https://www.commerce.gov/news/press-releases/2021/05/don-graves-sworn-deputy-secretary-commerce",
      "excerpted": true,
      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s26",
      "added": "2026-11-09"
    },
    {
      "text": "Department of Justice &amp; vigilant in our enforcement of our export controls. This interagency strike force will further strengthen this shared national security priority. https://t.co/aKwYb0LFEO",
      "date": "2023-02-16",
      "date_quote": "2023-02-16T23:18:27.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1626360386500034560",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
        "account": "DepSecGraves",
        "user_id": "1392831444616101888",
        "organization_id": "commerce",
        "role": "Deputy Secretary of Commerce"
      },
      "retrieved_on": "2026-11-09",
      "source_text_sha256": "0fcaa31229b4fc3707848443774e48ccb92a7f0a500b6d10860a264f8db6f4ab",
      "origin": "federal_x",
      "post_id": "1626360386500034560",
      "account_source_url": "https://www.commerce.gov/news/press-releases/2021/05/don-graves-sworn-deputy-secretary-commerce",
      "excerpted": true,
      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s27",
      "added": "2026-11-09"
    },
    {
      "text": "🇺🇸-🇰🇷 alliance and our strong economic ties. We also discussed ongoing collaboration on export controls, IPEF, and our bilateral Supply Chain and Commercial Dialogue. https://t.co/EVbkB6NpAW",
      "date": "2023-02-16",
      "date_quote": "2023-02-16T22:08:43.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1626342839394385921",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
        "account": "DepSecGraves",
        "user_id": "1392831444616101888",
