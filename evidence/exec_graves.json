      "attribution_span_sha256": "98b8a1d945ec4ee4e4f5e2d44d640ab884f12ecbffdfdeba6a37bd408da18754",
      "sid": "s25",
      "added": "2026-11-09"
    },
    {
      "text": "one year since Russia’s invasion of Ukraine, we continue to use export controls to hold Russia accountable for its unwarranted aggression.\n \nLet me explain: https://t.co/AUFlceZLRy",
      "date": "2023-02-24",
      "date_quote": "2023-02-24T20:51:00.000Z",
      "context": "Verified direct statement by Don Graves. Local verification records retain the source attribution.",
      "url": "https://x.com/DepSecGraves/status/1629222385022013440",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Don Graves",
        "basis": "verified_x_account",
        "account": "DepSecGraves",
        "user_id": "1392831444616101888",
