      "sid": "s11",
      "added": "2026-11-09"
    },
    {
      "text": "spoke about how we’re using AI at @StateDept to free up staff to focus on what’s essential, as well as improving our analysis to unearth",
      "date": "2024-06-28",
      "date_quote": "2024-06-28T23:09:39.000Z",
      "context": "Verified direct statement by Antony Blinken. Local verification records retain the source attribution.",
      "url": "https://x.com/SecBlinken/status/1806827331467767872",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
