    {
      "text": "work together to meet this AI moment.\n\nProud to join our G7 partners in announcing a code of conduct for companies developing AI, which will",
      "date": "2023-10-31",
      "date_quote": "2023-10-31T22:00:02.000Z",
      "context": "Verified direct statement by Antony Blinken. Local verification records retain the source attribution.",
      "url": "https://x.com/SecBlinken/status/1719474335365427274",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "Antony Blinken",
        "basis": "verified_x_account",
        "account": "SecBlinken",
        "user_id": "1350150750966603777",
