      "sid": "s12",
      "added": "2026-11-09"
    },
    {
      "text": "unveiled our International Cyberspace and Digital Strategy – the @StateDept's approach to technologies, from advanced computing and quantum technologies to artificial intelligence and biotechnology. https://t.co/UPWIqGtk7X",
      "date": "2024-05-07",
      "date_quote": "2024-05-07T01:17:17.000Z",
      "context": "Verified direct statement by Antony Blinken. Local verification records retain the source attribution.",
      "url": "https://x.com/SecBlinken/status/1787652895644520684",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
