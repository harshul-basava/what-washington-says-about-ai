      "sid": "s6",
      "added": "2026-11-09"
    },
    {
      "text": "on how the Pentagon uses AI, including in partnerships with companies like Anthropic. The Defense Department should be upfront with the public: Are you building",
      "date": "2026-02-27",
      "date_quote": "2026-02-27T19:13:39.000Z",
      "context": "Verified direct statement by Antony Blinken. Local verification records retain the source attribution.",
      "url": "https://x.com/ABlinken/status/2027462147937128515",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "personal",
        "speaker": "Antony Blinken",
        "basis": "verified_x_account",
        "account": "ABlinken",
        "user_id": "635716830"
      },
      "retrieved_on": "2026-11-09",
