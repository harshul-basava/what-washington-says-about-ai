      "sid": "s14",
      "added": "2026-11-09"
    },
    {
      "text": "to a democratic vision for AI and other technologies that promotes and protects human rights and makes the benefits of technology inclusive and accessible for",
      "date": "2024-03-18",
      "date_quote": "2024-03-18T07:07:07.000Z",
      "context": "Verified direct statement by Antony Blinken. Local verification records retain the source attribution.",
      "url": "https://x.com/SecBlinken/status/1769621537617756536",
