      "sid": "s13",
      "added": "2026-11-09"
    },
    {
      "text": "VP Vance on Super Intelligence: \n\n\"We need to have an AI conversation that's built around making sure these tools actually work, but not absolving companies",
      "date": "2026-09-29",
      "date_quote": "2026-09-29T23:04:20.000Z",
      "context": "Verified direct statement by JD Vance. Local verification records retain the source attribution.",
      "url": "https://x.com/VP/status/2105071204851970110",
      "source_type": "x",
      "verified": true,
      "verified_via": "x_api_post_text_and_author_id",
      "attribution": {
        "kind": "official_role",
        "speaker": "JD Vance",
        "basis": "verified_x_account",
        "account": "VP",
        "user_id": "1879652428490149888",
        "organization_id": "white_house",
        "role": "Vice President"
      },
      "retrieved_on": "2026-11-09",
      "source_text_sha256": "d8bc5c216d1f74262cf74313a33e879be79606be5ea94d0568eaf74b6d667880",
      "origin": "federal_x",
      "post_id": "2105071204851970110",
      "account_source_url": "https://www.nbcnews.com/politics/jd-vance/vances-unfiltered-err-side-openness-social-media-presence-rcna196772",
      "excerpted": true,
      "attribution_span_sha256": "6c1bd1b5e4465c516b53f920ce653b6115641d258df3bfe8fd806607e6ec32b5",
      "sid": "s14",
      "added": "2026-11-09"
    },
    {
      "text": "Vice President Vance on using AI: \n\n\"My kids found a timber rattlesnake. We saw it on a hiking trail, and I took a photo of",
      "date": "2026-09-23",
      "date_quote": "2026-09-23T13:47:04.000Z",
      "context": "Verified direct statement by JD Vance. Local verification records retain the source attribution.",
      "url": "https://x.com/VP/status/2102756638209802452",
