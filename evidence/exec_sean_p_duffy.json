      "attribution_span_sha256": "d894c29bdbac2c7adbe609f70dfd147e9f9f0eeb28fc9b54c5d27714e50a634c",
      "sid": "s6",
      "added": "2026-11-10"
    },
    {
      "text": "New AI software won’t replace air traffic controllers — but it’ll help them catch delays before they happen, manage weather disruptions, and ease congestion for",
      "date": "2026-09-02",
      "date_quote": "2026-09-02T17:55:07.000Z",
      "context": "Verified direct statement by Sean P. Duffy. Local verification records retain the source attribution.",
      "url": "https://x.com/SecDuffy/status/2095208916032299012",
